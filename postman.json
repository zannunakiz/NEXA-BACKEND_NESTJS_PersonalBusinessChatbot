    {
      "listen": "test",
      "script": {
        "exec": [
          "console.log('📌 Response Status:', pm.response.code);",
          "console.log('📌 Response Body:', pm.response.text());",
          "",
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "    try {",
          "        var jsonData = pm.response.json();",
          "        console.log('📌 Parsed Response:', JSON.stringify(jsonData, null, 2));",
          "        ",
          "        // Extract from data object (new structure)",
          "        var responseData = jsonData.data || jsonData;",
          "        ",
          "        // FORCE UPDATE accessToken",
          "        if (responseData.accessToken) {",
          "            pm.collectionVariables.set('accessToken', responseData.accessToken);",
          "            console.log('✅ ACCESS TOKEN SET:', responseData.accessToken.substring(0, 20) + '...');",
          "        } else if (jsonData.accessToken) {",
          "            pm.collectionVariables.set('accessToken', jsonData.accessToken);",
          "            console.log('✅ ACCESS TOKEN SET (root):', jsonData.accessToken.substring(0, 20) + '...');",
          "        } else {",
          "            console.log('❌ No accessToken found in response');",
          "        }",
          "        ",
          "        // FORCE UPDATE refreshToken",
          "        if (responseData.refreshToken) {",
          "            pm.collectionVariables.set('refreshToken', responseData.refreshToken);",
          "            console.log('✅ REFRESH TOKEN SET:', responseData.refreshToken.substring(0, 20) + '...');",
          "        } else if (jsonData.refreshToken) {",
          "            pm.collectionVariables.set('refreshToken', jsonData.refreshToken);",
          "            console.log('✅ REFRESH TOKEN SET (root):', jsonData.refreshToken.substring(0, 20) + '...');",
          "        } else {",
          "            console.log('❌ No refreshToken found in response');",
          "        }",
          "        ",
          "        // FORCE UPDATE user data - check both data.user and root user",
          "        var userData = null;",
          "        if (responseData.user) {",
          "            userData = responseData.user;",
          "            console.log('📌 User data found in data.user');",
          "        } else if (jsonData.user) {",
          "            userData = jsonData.user;",
          "            console.log('📌 User data found in root.user');",
          "        } else if (responseData.id || responseData.email) {",
          "            userData = responseData;",
          "            console.log('📌 User data found in data root');",
          "        }",
          "        ",
          "        if (userData) {",
          "            if (userData.id) {",
          "                pm.collectionVariables.set('userId', userData.id);",
          "                console.log('✅ User ID set:', userData.id);",
          "            }",
          "            if (userData.email) {",
          "                pm.collectionVariables.set('userEmail', userData.email);",
          "                console.log('✅ User Email set:', userData.email);",
          "            }",
          "            if (userData.username) {",
          "                pm.collectionVariables.set('username', userData.username);",
          "                console.log('✅ Username set:', userData.username);",
          "            }",
          "            if (userData.image_url) {",
          "                console.log('📌 User image:', userData.image_url);",
          "            }",
          "        }",
          "        ",
          "        // VERIFY variables were set",
          "        var finalAccess = pm.collectionVariables.get('accessToken');",
          "        var finalRefresh = pm.collectionVariables.get('refreshToken');",
          "        console.log('📌 FINAL VARIABLE STATE:', {",
          "            accessToken: finalAccess ? '✓ (' + finalAccess.substring(0, 15) + '...)' : '✗ EMPTY',",
          "            refreshToken: finalRefresh ? '✓ (' + finalRefresh.substring(0, 15) + '...)' : '✗ EMPTY',",
          "            userId: pm.collectionVariables.get('userId') || '✗ EMPTY',",
          "            userEmail: pm.collectionVariables.get('userEmail') || '✗ EMPTY',",
          "            username: pm.collectionVariables.get('username') || '✗ EMPTY'",
          "        });",
          "        ",
          "    } catch(e) {",
          "        console.log('❌ Error processing response:', e.message);",
          "    }",
          "} else {",
          "    console.log('❌ Response code not 200/201, skipping variable update');",
          "}"
        ],
        "type": "text/javascript"
      }
    }
