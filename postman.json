  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Auto-generate unique credentials for registration if needed",
          "// Emails resolve to carminealty@gmail.com via the + alias tag",
          "if (request.body && request.body.mode === 'raw') {",
          "  try {",
          "    let body = JSON.parse(request.body.raw);",
          "    if (body.email && body.email.includes('@')) {",
          "      body.email = `carminealty+${Date.now()}@gmail.com`;",
          "      request.body.raw = JSON.stringify(body);",
          "    }",
          "    if (body.username && body.username !== '') {",
          "      body.username = `user_${Date.now().toString(36)}`;",
          "      request.body.raw = JSON.stringify(body);",
          "    }",
          "  } catch(e) {}",
          "}"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "  try {",
          "    let json = pm.response.json();",
          "    let data = json.data || json;",
          "    let path = pm.request.url.getPath();",
          "    // Update tokens",
          "    if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
          "    if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
          "    // Update user data",
          "    let user = data.user || data;",
          "    if (user.id) pm.collectionVariables.set('userId', user.id);",
          "    if (user.email) pm.collectionVariables.set('userEmail', user.email);",
          "    if (user.username) pm.collectionVariables.set('username', user.username);",
          "    // Update org id only on /organization create responses",
          "    if (data.id && !data.user && path.indexOf('/organization') === 0) pm.collectionVariables.set('organizationId', data.id);",
          "    // Update chatbot id on /chatbot create responses",
          "    if (data.id && !data.user && path.indexOf('/chatbot') === 0) pm.collectionVariables.set('chatbotId', data.id);",
          "    // Update characteristic id on /characteristic create responses",
          "    if (data.id && !data.user && path.indexOf('/characteristic') === 0) pm.collectionVariables.set('characteristicId', data.id);",
          "    // Update session/chatbot ids on /session create-or-resume responses",
          "    if (data.session && data.session.id) pm.collectionVariables.set('sessionId', data.session.id);",
          "    if (data.chatbot && data.chatbot.id) pm.collectionVariables.set('chatbotId', data.chatbot.id);",
          "    // Update member id only on member list responses",
          "    if (Array.isArray(data) && data.length && data[0].id && path.indexOf('/members') !== -1) pm.collectionVariables.set('memberId', data[0].id);",
          "  } catch(e) {}",
          "}"
        ],
        "type": "text/javascript"
      }
    }
