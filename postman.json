  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Auto-generate unique credentials for registration if needed",
          "if (request.body && request.body.mode === 'raw') {",
          "  try {",
          "    let body = JSON.parse(request.body.raw);",
          "    if (body.email && body.email.includes('@')) {",
          "      body.email = `user_${Date.now()}@nuxa.ai`;",
          "      request.body.raw = JSON.stringify(body);",
          "    }",
          "    if (body.username && body.username !== '') {",
          "      body.username = `user_${Date.now().toString(36)}`;",
          "      request.body.raw = JSON.stringify(body);",
          "    }",
          "  } catch(e) {}",
          "}"
        ],
        "type": "text/javascript"
      }
    },
    {
      "listen": "test",
      "script": {
        "exec": [
          "if (pm.response.code === 200 || pm.response.code === 201) {",
          "  try {",
          "    let json = pm.response.json();",
          "    let data = json.data || json;",
          "    // Update tokens",
          "    if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
          "    if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
          "    // Update user data",
          "    let user = data.user || data;",
          "    if (user.id) pm.collectionVariables.set('userId', user.id);",
          "    if (user.email) pm.collectionVariables.set('userEmail', user.email);",
          "    if (user.username) pm.collectionVariables.set('username', user.username);",
          "    // Update org/member IDs if present",
          "    if (data.id && !data.user) pm.collectionVariables.set('organizationId', data.id);",
          "    if (Array.isArray(data) && data.length && data[0].id) pm.collectionVariables.set('memberId', data[0].id);",
          "  } catch(e) {}",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
