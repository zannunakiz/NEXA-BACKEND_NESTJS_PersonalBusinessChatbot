{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testRegex": "tests/e2e/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": ["node_modules/(?!(uuid)/)"],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testEnvironment": "node",
  "testTimeout": 120000,
  "verbose": true
}
